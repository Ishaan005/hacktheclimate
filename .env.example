# Copy to .env (git-ignored) or run scripts/fetch_azure_openai_env.sh 12
AZURE_OPENAI_ENDPOINT=https://<endpoint>.openai.azure.com/
AZURE_OPENAI_API_KEY=<azure-openai-key from Key Vault>
# gpt-4.1 | gpt-4.1-mini | gpt-4o  (gpt-5.1 needs api version 2025-04-01-preview)
AZURE_OPENAI_DEPLOYMENT=gpt-4.1
AZURE_OPENAI_API_VERSION=2024-10-21
